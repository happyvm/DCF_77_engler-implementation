[options]
# k-induction: the run/candidate phase relation in the formal testbench is
# mutually inductive with the goals, so this proves one full run for every
# legal field -- including field==3 (year, 0..99, the longest) -- without the
# long BMC unroll the previous 40-step z3 proof needed (and which had to
# exclude the year field).  cvc5 discharges it in well under a second.
mode prove
depth 6

[engines]
smtbmc cvc5

[script]
read -formal -sv calendar_candidate_search.sv calendar_candidate_search_formal.sv
prep -top calendar_candidate_search_formal

[files]
rtl/ml_decoder/calendar_candidate_search.sv
formal/calendar_candidate_search_formal.sv
