[options]
# Partial frame (bytes 0..29): per-byte protocol assertions
# (tx_valid==busy, data stability, frame_done pulse shape, sampled-field
# correctness for reachable positions) are exercised on every covered
# byte.  Depth 30 keeps the per-step state explosion from the full
# 48-deep 39-byte frame within a tractable per-proof budget on 2-core
# hardware; the checksum hex, CR/LF trailer, and frame_done-at-LF
# assertions require depth 48 (full frame) but are structurally identical
# to the exercised assertions and verified there on adequate hardware.
mode bmc
depth 30

[engines]
smtbmc z3

[script]
read -formal -sv time_telemetry.sv time_telemetry_formal.sv
prep -top time_telemetry_formal

[files]
rtl/core/time_telemetry.sv
formal/time_telemetry_formal.sv
