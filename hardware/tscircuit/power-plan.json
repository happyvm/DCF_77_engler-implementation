{
  "revision": "rev0",
  "policy": {
    "analog_no_trim": true,
    "power_passives_no_per_unit_selection": true,
    "switchers_confined_to_digital_power_region": true,
    "reference_switcher_mode": "forced_pwm",
    "spread_spectrum_default": false
  },
  "rails": {
    "5V_SYS": {
      "nominal_v": 5.0,
      "source_standalone": "TPS259470ARPWR output",
      "source_hat": "TPS22975NDSGR output"
    },
    "5V_AFE": {
      "nominal_v": 5.0,
      "source": "5V_SYS",
      "series_resistor_ohm": 0.1,
      "series_resistor_tolerance_percent": 1,
      "bulk_cap_uF": 100,
      "mid_cap_uF": 1,
      "hf_cap_uF": 0.1,
      "design_current_mA": 75,
      "loads": ["OPA810IDBVR", "LTC1562IG#PBF", "LTC6912IGN-1#PBF"]
    },
    "3V3_ADC_A": {
      "nominal_v": 3.3,
      "regulator": "LT3042EMSE#PBF",
      "input": "5V_SYS",
      "rset_ohm": 33200,
      "rset_tolerance_percent": 0.1,
      "cset_uF": 4.7,
      "cin_uF": 10,
      "cout_uF": 10,
      "loads": ["LTC1407AIMSE-1#PBF", "OPA2835IDGSR"]
    },
    "3V3_CLK": {
      "nominal_v": 3.3,
      "regulator": "TPS7A2033PDQNR",
      "input": "5V_SYS",
      "cin_uF": 2.2,
      "cout_uF": 2.2,
      "load_local_bypass_uF": 0.1,
      "loads": ["SiT5356AI-FQ-33E0-25.000000"]
    },
    "3V3_D": {
      "nominal_v": 3.3,
      "source_standalone": "TPS628502DRLR",
      "source_hat": "PI_3V3 via current-measure/0R link",
      "loads": [
        "ECP5 VCCIO banks",
        "ECP5 VCCIO8",
        "W25Q64JVSSIQ",
        "LCD logic",
        "PPS/host I/O",
        "HAT ID EEPROM on HAT variant"
      ]
    },
    "2V5_AUX": {
      "nominal_v": 2.5,
      "regulator": "TPS7A2025PDQNR",
      "input": "3V3_D",
      "cin_uF": 2.2,
      "cout_uF": 2.2,
      "loads": ["ECP5 VCCAUX"]
    },
    "1V1_CORE": {
      "nominal_v": 1.1,
      "regulator": "TPS628502DRLR",
      "input": "5V_SYS",
      "loads": ["ECP5 VCC"]
    }
  },
  "tps628502_common": {
    "opn": "TPS628502DRLR",
    "inductor": {
      "opn": "DFE252012PD-R47M=P2",
      "inductance_uH": 0.47
    },
    "comp_fset_resistor_ohm": 5760,
    "comp_fset_tolerance_percent": 1,
    "nominal_switching_frequency_MHz": 3.125,
    "ssc_enabled": false,
    "mode": "forced_pwm",
    "mode_pullup_ohm": 10000,
    "cin_uF": 10,
    "cin_hf_uF": 0.1,
    "cout_each_uF": 10,
    "cout_count": 2,
    "capacitor_dielectric": "X7R",
    "core_feedback": {
      "rtop_ohm": 39200,
      "rbot_ohm": 47000,
      "tolerance_percent": 0.1,
      "cff_pF": 10,
      "cff_dielectric": "C0G/NP0"
    },
    "standalone_3v3_feedback": {
      "rtop_ohm": 88700,
      "rbot_ohm": 19600,
      "tolerance_percent": 0.1,
      "cff_pF": 10,
      "cff_dielectric": "C0G/NP0"
    }
  },
  "hat_input": {
    "load_switch": "TPS22975NDSGR",
    "vin": "PI_5V",
    "vbias": "PI_5V",
    "on": "PI_3V3",
    "on_pulldown_ohm": 100000,
    "ct_nF": 1.0,
    "ct_min_voltage_rating_v": 30,
    "output": "5V_SYS",
    "pi_3v3_current_measure_link": true,
    "standby_policy": "PI_3V3 absent disables 5V_SYS and all local receiver rails"
  },
  "sequencing": {
    "standalone": [
      "5V_SYS valid after USB-C eFuse",
      "3V3_D buck starts",
      "VCCIO8 and W25Q64 become valid",
      "2V5_AUX starts from 3V3_D",
      "PG_3V3_D enables 1V1_CORE",
      "ECP5 internal POR releases only after VCC/VCCAUX/VCCIO8 thresholds"
    ],
    "hat": [
      "PI_3V3 becomes valid and directly powers 3V3_D/VCCIO8/W25Q64",
      "PI_3V3 enables TPS22975NDSGR",
      "5V_SYS rises with CT-controlled slew",
      "1V1_CORE and local analog/clock rails start from 5V_SYS",
      "2V5_AUX starts from PI_3V3/3V3_D",
      "ECP5 internal POR releases only after VCC/VCCAUX/VCCIO8 thresholds"
    ]
  },
  "ecp5_decoupling": {
    "1V1_CORE": {
      "local_100nF_count": 6,
      "bulk_10uF_count": 2
    },
    "2V5_AUX": {
      "local_100nF_count": 2,
      "bulk_4_7uF_count": 1
    },
    "3V3_D": {
      "per_vccio_supply_ball_100nF": true,
      "per_bank_1uF": true,
      "bank8_flash_bulk_uF": 10,
      "main_ecp5_entry_bulk_uF": 10
    }
  },
  "references": [
    "docs/19-power-tree.md",
    "docs/26-hat-power.md",
    "docs/28-power-passives-sequencing.md",
    "hardware/tscircuit/pin-plan.json"
  ]
}
